// ponytail: Intentional simplification. Full 3D raycasting violates YAGNI. 
// This is a minimal top-down ASCII "Doom" (Dude Offending Ordinary Monsters).
// Upgrade path: Implement Wolfenstein 3D raycasting if true 3D is strictly required.

Перем Карта, ИгрокХ, ИгрокУ;

Процедура Инициализация()
    Карта = Новый Массив;
    Карта.Добавить("############");
    Карта.Добавить("#..........#");
    Карта.Добавить("#.###.####.#");
    Карта.Добавить("#.#E#.#..#.#");
    Карта.Добавить("#...#....#.#");
    Карта.Добавить("#.#####..#.#");
    Карта.Добавить("#S.........#");
    Карта.Добавить("############");
    ИгрокХ = 1;
    ИгрокУ = 6;
КонецПроцедуры

Процедура Отрисовка()
    // ponytail: ANSI escape via Символ(27) is the most robust cross-platform terminal clear.
    Сообщить(Символ(27) + "[2J" + Символ(27) + "[H");
    Для й = 0 По Карта.ВГраница() Цикл
        СтрокаОтрисовки = "";
        Для х = 0 По СтрДлина(Карта[й]) - 1 Цикл
            Если х = ИгрокХ И й = ИгрокУ Тогда
                СтрокаОтрисовки = СтрокаОтрисовки + "D"; // Doomguy
            Иначе
                СтрокаОтрисовки = СтрокаОтрисовки + Сред(Карта[й], х + 1, 1);
            КонецЕсли;
        КонецЦикла;
        Сообщить(СтрокаОтрисовки);
    КонецЦикла;
    Сообщить("WASD: движение, Q: выход. E: цель.");
КонецПроцедуры

Процедура Играть()
    Инициализация();
    Пока Истина Цикл
        Отрисовка();
        Если ИгрокХ = 3 И ИгрокУ = 3 Тогда
            Сообщить("ПОБЕДА! ДУМ ЗАЧИЩЕН.");
            Прервать;
        КонецЕсли;
        
        // ponytail: ВвестиСтроку requires Enter. Real-time non-blocking getch() requires 
        // platform-specific native calls, violating YAGNI and cross-platform simplicity. 
        // Upgrade path: wrap a native C library for raw terminal input if real-time FPS is needed.
        Ввод = ВвестиСтроку("Ход (и Enter): ");
        Если Ввод = "q" Или Ввод = "Q" Тогда
            Прервать;
        КонецЕсли;
        
        НовХ = ИгрокХ;
        НовУ = ИгрокУ;
        
        Если Ввод = "w" Или Ввод = "W" Тогда НовУ = НовУ - 1;
        ИначеЕсли Ввод = "s" Или Ввод = "S" Тогда НовУ = НовУ + 1;
        ИначеЕсли Ввод = "a" Или Ввод = "A" Тогда НовХ = НовХ - 1;
        ИначеЕсли Ввод = "d" Или Ввод = "D" Тогда НовХ = НовХ + 1;
        КонецЕсли;
        
        Если Сред(Карта[НовУ], НовХ + 1, 1) <> "#" Тогда
            ИгрокХ = НовХ;
            ИгрокУ = НовУ;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

