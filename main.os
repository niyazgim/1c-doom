// ponytail: Pure ASCII rendering (no Unicode blocks). Added exit goal + compass.
// No monsters, no sqrt, no arctan hacks. Just walk to E.

Перем Карта, ИгрокX, ИгрокY, ИгрокУгол, ИгрокHP;
Перем ВыходX, ВыходY;
Перем ШиринаКарты, ВысотаКарты;
Перем ШиринаЭкрана, ВысотаЭкрана, FOV, МаксГлубина, ПИ;

Процедура Инициализация()
    ПИ = 3.14159265;
    
    Карта = Новый Массив;
    Карта.Добавить("################");
    Карта.Добавить("#S.............#");
    Карта.Добавить("#.###.###.####.#");
    Карта.Добавить("#.#.......#....#");
    Карта.Добавить("#.#.#####.#.##.#");
    Карта.Добавить("#...#...#......#");
    Карта.Добавить("#####.#.######.#");
    Карта.Добавить("#.......#......#");
    Карта.Добавить("#.#####.#.####.#");
    Карта.Добавить("#.....#.......E#");
    Карта.Добавить("################");
    
    ШиринаКарты = СтрДлина(Карта[0]);
    ВысотаКарты = Карта.Количество();
    
    ИгрокX = 1.5;
    ИгрокY = 1.5;
    ИгрокУгол = 0.0;
    ИгрокHP = 100;
    
    ВыходX = 14.5;
    ВыходY = 9.5;
    
    ШиринаЭкрана = 60;
    ВысотаЭкрана = 20;
    FOV = ПИ / 3.0;
    МаксГлубина = 16.0;
КонецПроцедуры

Функция РасстояниеДоСтены(УголЛуча)
    Расстояние = 0.0;
    Пока Расстояние < МаксГлубина Цикл
        Расстояние = Расстояние + 0.1;
        ТестX = Цел(ИгрокX + Cos(УголЛуча) * Расстояние);
        ТестY = Цел(ИгрокY + Sin(УголЛуча) * Расстояние);
        
        Если ТестX < 0 Или ТестX >= ШиринаКарты Или ТестY < 0 Или ТестY >= ВысотаКарты Тогда
            Возврат МаксГлубина;
        Иначе
            Если Сред(Карта[ТестY], ТестX + 1, 1) = "#" Тогда
                Возврат Расстояние;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат МаксГлубина;
КонецФункции

Функция СимволСтены(Расстояние)
    Если Расстояние <= МаксГлубина / 6.0 Тогда Возврат "#";
    ИначеЕсли Расстояние <= МаксГлубина / 4.0 Тогда Возврат "=";
    ИначеЕсли Расстояние <= МаксГлубина / 3.0 Тогда Возврат "-";
    ИначеЕсли Расстояние <= МаксГлубина / 2.0 Тогда Возврат ":";
    Иначе Возврат ".";
    КонецЕсли;
КонецФункции

Процедура НарисоватьМиникарту()
    Сообщить("--- MAP ---");
    Для й = 0 По ВысотаКарты - 1 Цикл
        Строка = "";
        Для х = 0 По ШиринаКарты - 1 Цикл
            Если х = Цел(ИгрокX) И й = Цел(ИгрокY) Тогда
                Строка = Строка + "@";
            ИначеЕсли х = Цел(ВыходX) И й = Цел(ВыходY) Тогда
                Строка = Строка + "E";
            Иначе
                Строка = Строка + Сред(Карта[й], х + 1, 1);
            КонецЕсли;
        КонецЦикла;
        Сообщить(Строка);
    КонецЦикла;
    Сообщить("--- MAP ---");
КонецПроцедуры

Процедура Играть()
    Инициализация();
    
    Сообщить("================================");
    Сообщить("  DOOM 1C - FIND THE EXIT       ");
    Сообщить("================================");
    Сообщить("Иди к выходу E. Автодвижение вперёд.");
    Сообщить("a/d - поворот, q - выход");
    Сообщить("");
    
    Пока Истина Цикл
        Если ИгрокHP <= 0 Тогда
            Сообщить("ВЫ ПОГИБЛИ!");
            Прервать;
        КонецЕсли;
        
        // Проверка достижения выхода
        КвадратДоВыхода = (ИгрокX - ВыходX) * (ИгрокX - ВыходX) + (ИгрокY - ВыходY) * (ИгрокY - ВыходY);
        Если КвадратДоВыхода < 1.0 Тогда
            Сообщить("ВЫ НАШЛИ ВЫХОД! ПОБЕДА!");
            Прервать;
        КонецЕсли;
        
        // Автодвижение вперёд
        Шаг = 0.15;
        НовX = ИгрокX + Cos(ИгрокУгол) * Шаг;
        НовY = ИгрокY + Sin(ИгрокУгол) * Шаг;
        
        Если НовX >= 0 И НовX < ШиринаКарты И НовY >= 0 И НовY < ВысотаКарты Тогда
            Если Сред(Карта[Цел(НовY)], Цел(НовX) + 1, 1) <> "#" Тогда
                ИгрокX = НовX;
                ИгрокY = НовY;
            КонецЕсли;
        КонецЕсли;
        
        // Рендеринг raycast-вида
        Экран = Новый Массив;
        
        Для х = 0 По ШиринаЭкрана - 1 Цикл
            УголЛуча = (ИгрокУгол - FOV / 2.0) + (х / ШиринаЭкрана) * FOV;
            Расст = РасстояниеДоСтены(УголЛуча);
            
            Исправленное = Расст * Cos(УголЛуча - ИгрокУгол);
            Если Исправленное <= 0.1 Тогда Исправленное = 0.1; КонецЕсли;
            
            Потолок = Цел(ВысотаЭкрана / 2.0 - ВысотаЭкрана / Исправленное);
            Пол = ВысотаЭкрана - Потолок;
            Если Потолок < 0 Тогда Потолок = 0; КонецЕсли;
            Если Пол >= ВысотаЭкрана Тогда Пол = ВысотаЭкрана - 1; КонецЕсли;
            
            Для у = 0 По ВысотаЭкрана - 1 Цикл
                Если у < Потолок Тогда
                    Символ = " ";
                ИначеЕсли у <= Пол Тогда
                    Символ = СимволСтены(Исправленное);
                Иначе
                    Символ = ".";
                КонецЕсли;
                
                Если х = 0 Тогда
                    Экран.Добавить(Символ);
                Иначе
                    Экран[у] = Экран[у] + Символ;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        
        // Вывод
        Сообщить(Символ(27) + "[2J" + Символ(27) + "[H");
        Сообщить("HP: " + ИгрокHP);
        
        // Компас: направление к выходу
        ДельтаX = ВыходX - ИгрокX;
        ДельтаY = ВыходY - ИгрокY;
        
        // Определяем квадрант относительно взгляда игрока
        // Локальные координаты: вперёд = (cos, sin), вправо = (-sin, cos)
        Вперёд = ДельтаX * Cos(ИгрокУгол) + ДельтаY * Sin(ИгрокУгол);
        Вправо = -ДельтаX * Sin(ИгрокУгол) + ДельтаY * Cos(ИгрокУгол);
        
        Стрелка = " ";
        Если Вперёд > 0 И Вправо > 1 Тогда Стрелка = "/";
        ИначеЕсли Вперёд > 0 И Вправо < -1 Тогда Стрелка = "\";
        ИначеЕсли Вперёд > 0 Тогда Стрелка = "^";
        ИначеЕсли Вперёд < 0 И Вправо > 1 Тогда Стрелка = "\";
        ИначеЕсли Вперёд < 0 И Вправо < -1 Тогда Стрелка = "/";
        ИначеЕсли Вперёд < 0 Тогда Стрелка = "v";
        ИначеЕсли Вправо > 0 Тогда Стрелка = ">";
        ИначеЕсли Вправо < 0 Тогда Стрелка = "<";
        КонецЕсли;
        
        Сообщить("Выход: " + Стрелка + " (расст: " + Цел((ДельтаX * ДельтаX + ДельтаY * ДельтаY)) + ")");
        Сообщить("");
        
        Для Каждого СтрокаЭкрана Из Экран Цикл
            Сообщить(СтрокаЭкрана);
        КонецЦикла;
        
        Сообщить("");
        НарисоватьМиникарту();
        Сообщить("a/d - поворот | q - выход");
        
        Команда = "";
        Попытка
            ВвестиСтроку(Команда);
        Исключение
            Прервать;
        КонецПопытки;
        
        Команда = НРег(СокрЛП(Команда));
        
        Если Команда = "q" Тогда
            Прервать;
        КонецЕсли;
        
        Поворот = 0.4;
        Если Команда = "a" Тогда
            ИгрокУгол = ИгрокУгол - Поворот;
        ИначеЕсли Команда = "d" Тогда
            ИгрокУгол = ИгрокУгол + Поворот;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Играть();
