Перем Карта;
Перем ИгрокX, ИгрокY, ИгрокУгол, ИгрокHP;
Перем ВыходX, ВыходY;
Перем ШиринаКарты, ВысотаКарты;
Перем ШиринаЭкрана, ВысотаЭкрана;
Перем FOV, МаксГлубина, ПИ;
Перем Монстры;
Перем КадровВыстрела;
Перем УронВспышка;
Перем ДвижениеВперед, ДвижениеВбок, ДвижениеПоворот, ДвижениеТаймер;

Процедура Инициализация()

    ПИ = 3.14159265359;

    Карта = Новый Массив;
    Карта.Добавить("################");
    Карта.Добавить("#S.............#");
    Карта.Добавить("#.###.###.####.#");
    Карта.Добавить("#.#.......#....#");
    Карта.Добавить("#.#.#####.#.##.#");
    Карта.Добавить("#...#...#......#");
    Карта.Добавить("#####.#.######.#");
    Карта.Добавить("#.......#......#");
    Карта.Добавить("#.#####.#.####.#");
    Карта.Добавить("#.....#.......E#");
    Карта.Добавить("################");

    ШиринаКарты = СтрДлина(Карта[0]);
    ВысотаКарты = Карта.Количество();

    ИгрокX = 1.5;
    ИгрокY = 1.5;
    ИгрокУгол = 0;
    ИгрокHP = 100;

    ВыходX = 14.5;
    ВыходY = 9.5;

    ШиринаЭкрана = 128;
    ВысотаЭкрана = 36;

    FOV = ПИ / 3;
    МаксГлубина = 16;

    Монстры = Новый Массив;
    ДобавитьМонстра(7.5, 1.5, 40);
    ДобавитьМонстра(12.5, 3.5, 50);
    ДобавитьМонстра(5.5, 7.5, 60);
    ДобавитьМонстра(12.5, 8.5, 70);

    КадровВыстрела = 0;
    УронВспышка = 0;
    ДвижениеВперед = 0;
    ДвижениеВбок = 0;
    ДвижениеПоворот = 0;
    ДвижениеТаймер = 0;

КонецПроцедуры


Процедура ДобавитьМонстра(Х, У, HP)

    Монстр = Новый Структура;
    Монстр.Вставить("X", Х);
    Монстр.Вставить("Y", У);
    Монстр.Вставить("HP", HP);
    Монстр.Вставить("Cooldown", 0);
    Монстр.Вставить("Alive", Истина);
    Монстр.Вставить("DeathFrame", 0);
    Монстры.Добавить(Монстр);

КонецПроцедуры


Функция МодульЧисла(Значение)
    Если Значение < 0 Тогда
        Возврат -Значение;
    КонецЕсли;
    Возврат Значение;
КонецФункции


Функция ЭтоСтена(Х, У)
    Если Х < 0 Или Х >= ШиринаКарты Тогда
        Возврат Истина;
    КонецЕсли;
    Если У < 0 Или У >= ВысотаКарты Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Сред(Карта[У], Х + 1, 1) = "#";
КонецФункции


Функция Свободно(Х, У)
    Если ЭтоСтена(Цел(Х), Цел(У)) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции


Функция РасстояниеДоСтены(Угол)

    Расстояние = 0;

    Пока Расстояние < МаксГлубина Цикл
        Расстояние = Расстояние + 0.08;
        ТестX = Цел(ИгрокX + Cos(Угол) * Расстояние);
        ТестY = Цел(ИгрокY + Sin(Угол) * Расстояние);
        Если ЭтоСтена(ТестX, ТестY) Тогда
            Возврат Расстояние;
        КонецЕсли;
    КонецЦикла;

    Возврат МаксГлубина;

КонецФункции


Функция ВидитИгрока(Х, У)

    ДХ = ИгрокX - Х;
    ДУ = ИгрокY - У;
    Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);

    Если Расстояние < 0.1 Тогда
        Возврат Истина;
    КонецЕсли;

    КоличествоШагов = Цел(Расстояние / 0.1);
    Если КоличествоШагов < 1 Тогда
        КоличествоШагов = 1;
    КонецЕсли;

    НомерШага = 1;

    Пока НомерШага <= КоличествоШагов Цикл
        Доля = НомерШага / КоличествоШагов;
        ПроверкаX = Х + ДХ * Доля;
        ПроверкаY = У + ДУ * Доля;
        Если ЭтоСтена(Цел(ПроверкаX), Цел(ПроверкаY)) Тогда
            Возврат Ложь;
        КонецЕсли;
        НомерШага = НомерШага + 1;
    КонецЦикла;

    Возврат Истина;

КонецФункции


Процедура ДвигатьИгрока(Вперед, Вправо, Дельта)

    Скорость = 1.8;
    Расстояние = Скорость * Дельта;

    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);
    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    НовX = ИгрокX + НаправлениеX * Вперед * Расстояние + ПравоX * Вправо * Расстояние;
    НовY = ИгрокY + НаправлениеY * Вперед * Расстояние + ПравоY * Вправо * Расстояние;

    Если Свободно(НовX, ИгрокY) Тогда
        ИгрокX = НовX;
    КонецЕсли;

    Если Свободно(ИгрокX, НовY) Тогда
        ИгрокY = НовY;
    КонецЕсли;

КонецПроцедуры


Процедура ПрименитьДвижение(Дельта)

    // ponytail: velocity model - keypress sets direction, loop applies it for ~0.35s.
    // Held key auto-repeats and refreshes the timer -> continuous motion. Tap = one short glide.
    Если ДвижениеТаймер > 0 Тогда

        Если ДвижениеВперед <> 0 Или ДвижениеВбок <> 0 Тогда
            ДвигатьИгрока(ДвижениеВперед, ДвижениеВбок, Дельта);
        КонецЕсли;

        Если ДвижениеПоворот <> 0 Тогда
            ИгрокУгол = ИгрокУгол + ДвижениеПоворот * 1.5 * Дельта;
        КонецЕсли;

        ДвижениеТаймер = ДвижениеТаймер - 1;

    КонецЕсли;

КонецПроцедуры


Процедура ОбновитьМонстров(Дельта)

    Если УронВспышка > 0 Тогда
        УронВспышка = УронВспышка - 1;
    КонецЕсли;

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.DeathFrame > 0 Тогда
            Монстр.DeathFrame = Монстр.DeathFrame - 1;
        КонецЕсли;

        Если Монстр.Alive Тогда

            Если Монстр.Cooldown > 0 Тогда
                Монстр.Cooldown = Монстр.Cooldown - Дельта;
            КонецЕсли;

            ДХ = ИгрокX - Монстр.X;
            ДУ = ИгрокY - Монстр.Y;
            Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);

            Если Расстояние < 0.9 Тогда
                Если Монстр.Cooldown <= 0 Тогда
                    ИгрокHP = ИгрокHP - 10;
                    Монстр.Cooldown = 0.8;
                    УронВспышка = 4;
                КонецЕсли;
            ИначеЕсли Расстояние < 12 И ВидитИгрока(Монстр.X, Монстр.Y) Тогда
                НаправлениеX = ДХ / Расстояние;
                НаправлениеY = ДУ / Расстояние;
                Скорость = 0.7;
                НовX = Монстр.X + НаправлениеX * Скорость * Дельта;
                НовY = Монстр.Y + НаправлениеY * Скорость * Дельта;
                Если Свободно(НовX, Монстр.Y) Тогда
                    Монстр.X = НовX;
                КонецЕсли;
                Если Свободно(Монстр.X, НовY) Тогда
                    Монстр.Y = НовY;
                КонецЕсли;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


Процедура Стрелять()

    ЛучшийМонстр = Неопределено;
    ЛучшееРасстояние = МаксГлубина;

    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);
    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Тогда

            ДХ = Монстр.X - ИгрокX;
            ДУ = Монстр.Y - ИгрокY;
            Вперед = ДХ * НаправлениеX + ДУ * НаправлениеY;
            Вправо = ДХ * ПравоX + ДУ * ПравоY;

            Если Вперед > 0.2 Тогда
                Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);
                Если Расстояние < МаксГлубина Тогда
                    ШиринаПрицеливания = Вперед * 0.10 + 0.25;
                    Если МодульЧисла(Вправо) < ШиринаПрицеливания Тогда
                        Если ВидитИгрока(Монстр.X, Монстр.Y) Тогда
                            Если Расстояние < ЛучшееРасстояние Тогда
                                ЛучшееРасстояние = Расстояние;
                                ЛучшийМонстр = Монстр;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    КадровВыстрела = 4;

    Если ЛучшийМонстр <> Неопределено Тогда

        ЛучшийМонстр.HP = ЛучшийМонстр.HP - 25;

        Если ЛучшийМонстр.HP <= 0 Тогда
            ЛучшийМонстр.Alive = Ложь;
            ЛучшийМонстр.DeathFrame = 6;
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработатьКлавиши(Дельта)

    // ponytail: each key sets ALL THREE axes, zeroing the ones it doesn't drive.
    // Earlier version only set its own axis, so a stale turn from A/D kept applying while
    // walking forward - that is why W turned the player.
    Попытка
        Есть = Консоль.НажатаКлавиша;
    Исключение
        Есть = Ложь;
    КонецПопытки;

    Если Не Есть Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Код = Консоль.Прочитать();
    Исключение
        Возврат;
    КонецПопытки;

    Если ТипЗнч(Код) = Тип("Строка") Тогда
        Клавиша = Код;
    ИначеЕсли Код = -1 Или Код = 0 Тогда
        Возврат;
    Иначе
        Клавиша = Символ(Код);
    КонецЕсли;

    Если Клавиша = "q" Или Клавиша = "Q" Тогда

        ИгрокHP = 0;

    ИначеЕсли Клавиша = "w" Или Клавиша = "W" Тогда

        ДвижениеВперед = 1;
        ДвижениеВбок = 0;
        ДвижениеПоворот = 0;
        ДвижениеТаймер = 7;

    ИначеЕсли Клавиша = "s" Или Клавиша = "S" Тогда

        ДвижениеВперед = -1;
        ДвижениеВбок = 0;
        ДвижениеПоворот = 0;
        ДвижениеТаймер = 7;

    ИначеЕсли Клавиша = "a" Или Клавиша = "A" Тогда

        ДвижениеВперед = 0;
        ДвижениеВбок = 0;
        ДвижениеПоворот = -1;
        ДвижениеТаймер = 7;

    ИначеЕсли Клавиша = "d" Или Клавиша = "D" Тогда

        ДвижениеВперед = 0;
        ДвижениеВбок = 0;
        ДвижениеПоворот = 1;
        ДвижениеТаймер = 7;

    ИначеЕсли Клавиша = " " Тогда

        Стрелять();

    КонецЕсли;

КонецПроцедуры


Функция СимволСтены(Расстояние)
    Если Расстояние < 2 Тогда
        Возврат "#";
    ИначеЕсли Расстояние < 4 Тогда
        Возврат "=";
    ИначеЕсли Расстояние < 7 Тогда
        Возврат "-";
    ИначеЕсли Расстояние < 10 Тогда
        Возврат ":";
    Иначе
        Возврат ".";
    КонецЕсли;
КонецФункции


Функция СоздатьЭкран()

    Экран = Новый Массив;
    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаЭкрана Цикл
        Строка = "";
        НомерКолонки = 0;
        Пока НомерКолонки < ШиринаЭкрана Цикл
            Строка = Строка + " ";
            НомерКолонки = НомерКолонки + 1;
        КонецЦикла;
        Экран.Добавить(Строка);
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    Возврат Экран;

КонецФункции


Процедура Поставить(Экран, X, Y, Символ)

    Если X >= 0 И X < ШиринаЭкрана И Y >= 0 И Y < ВысотаЭкрана Тогда
        Строка = Экран[Y];
        Экран[Y] = Лев(Строка, X) + Символ + Сред(Строка, X + 2);
    КонецЕсли;

КонецПроцедуры


Функция СпрайтДемона()

    Спрайт = Новый Массив;
    Спрайт.Добавить("   /\   /\   ");
    Спрайт.Добавить("  /  \_/  \  ");
    Спрайт.Добавить(" |  o   o  | ");
    Спрайт.Добавить(" |    ^    | ");
    Спрайт.Добавить("  \  ---  /  ");
    Спрайт.Добавить("  /|     |\  ");
    Спрайт.Добавить(" / |     | \ ");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить(" \ |     | / ");
    Спрайт.Добавить("  \|_____|/  ");
    Спрайт.Добавить("   |     |   ");
    Спрайт.Добавить("   |     |   ");
    Спрайт.Добавить("  / \   / \  ");
    Спрайт.Добавить(" /   \ /   \ ");

    Возврат Спрайт;

КонецФункции


Функция СпрайтТрупа()

    Спрайт = Новый Массив;
    Спрайт.Добавить("  _____  ");
    Спрайт.Добавить(" /     \ ");
    Спрайт.Добавить("| x   x |");
    Спрайт.Добавить("|  ___  |");
    Спрайт.Добавить(" \_____/ ");
    Спрайт.Добавить("~~~~~~~~~");

    Возврат Спрайт;

КонецФункции


Процедура НарисоватьПушку(Экран)

    Спрайт = Новый Массив;
    Спрайт.Добавить("    ____    ");
    Спрайт.Добавить("   |    |   ");
    Спрайт.Добавить("   |    |   ");
    Спрайт.Добавить("   |____|   ");
    Спрайт.Добавить("  /|    |\  ");
    Спрайт.Добавить(" / |    | \ ");
    Спрайт.Добавить("|__|____|__|");
    Спрайт.Добавить("   |    |   ");

    ВысотаПушки = Спрайт.Количество();
    ШиринаПушки = СтрДлина(Спрайт[0]);

    Левая = Цел((ШиринаЭкрана - ШиринаПушки) / 2);
    Верх = ВысотаЭкрана - ВысотаПушки;

    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаПушки Цикл

        НомерКолонки = 1;

        Пока НомерКолонки <= ШиринаПушки Цикл

            Символ = Сред(Спрайт[НомерСтроки], НомерКолонки, 1);

            Если Символ <> " " Тогда
                Поставить(Экран, Левая + НомерКолонки - 1, Верх + НомерСтроки, Символ);
            КонецЕсли;

            НомерКолонки = НомерКолонки + 1;

        КонецЦикла;

        НомерСтроки = НомерСтроки + 1;

    КонецЦикла;

    Если КадровВыстрела > 0 Тогда

        Вспышка = Новый Массив;
        Вспышка.Добавить(" @@@@@ ");
        Вспышка.Добавить("@@@@@@@");
        Вспышка.Добавить(" @@@@@ ");

        ШиринаВспышки = СтрДлина(Вспышка[0]);
        ЛеваяВспышки = Цел((ШиринаЭкрана - ШиринаВспышки) / 2);
        ВерхВспышки = Верх - Вспышка.Количество();

        ИндСтроки = 0;

        Пока ИндСтроки < Вспышка.Количество() Цикл

            ИндКол = 1;

            Пока ИндКол <= ШиринаВспышки Цикл

                С = Сред(Вспышка[ИндСтроки], ИндКол, 1);

                Если С <> " " Тогда
                    Поставить(Экран, ЛеваяВспышки + ИндКол - 1, ВерхВспышки + ИндСтроки, С);
                КонецЕсли;

                ИндКол = ИндКол + 1;

            КонецЦикла;

            ИндСтроки = ИндСтроки + 1;

        КонецЦикла;

    КонецЕсли;

КонецПроцедуры


Функция Нарисовать()

    Экран = СоздатьЭкран();

    Глубина = Новый Массив;
    ВерхМассив = Новый Массив;
    НизМассив = Новый Массив;
    СимволМассив = Новый Массив;

    Колонка = 0;

    Пока Колонка < ШиринаЭкрана Цикл

        Доля = Колонка / ШиринаЭкрана;
        Угол = ИгрокУгол - FOV / 2 + Доля * FOV;
        Расстояние = РасстояниеДоСтены(Угол);
        Исправленное = Расстояние * Cos(Угол - ИгрокУгол);

        Если Исправленное < 0.1 Тогда
            Исправленное = 0.1;
        КонецЕсли;

        Глубина.Добавить(Исправленное);

        ВысотаСтены = Цел(ВысотаЭкрана * 0.90 / Исправленное);
        Верх = Цел(ВысотаЭкрана / 2 - ВысотаСтены / 2);
        Низ = Цел(ВысотаЭкрана / 2 + ВысотаСтены / 2);

        Если Верх < 0 Тогда
            Верх = 0;
        КонецЕсли;

        Если Низ >= ВысотаЭкрана Тогда
            Низ = ВысотаЭкрана - 1;
        КонецЕсли;

        ВерхМассив.Добавить(Верх);
        НизМассив.Добавить(Низ);
        СимволМассив.Добавить(СимволСтены(Исправленное));

        Колонка = Колонка + 1;

    КонецЦикла;

    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаЭкрана Цикл

        Строка = "";
        Колонка = 0;

        Пока Колонка < ШиринаЭкрана Цикл

            Если НомерСтроки < ВерхМассив[Колонка] Тогда
                Символ = " ";
            ИначеЕсли НомерСтроки <= НизМассив[Колонка] Тогда
                Символ = СимволМассив[Колонка];
            Иначе
                Символ = ".";
            КонецЕсли;

            Строка = Строка + Символ;
            Колонка = Колонка + 1;

        КонецЦикла;

        Экран[НомерСтроки] = Строка;
        НомерСтроки = НомерСтроки + 1;

    КонецЦикла;

    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);
    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    Цели = Новый Массив;

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Или Монстр.DeathFrame > 0 Тогда

            ДХ = Монстр.X - ИгрокX;
            ДУ = Монстр.Y - ИгрокY;
            Вперед = ДХ * НаправлениеX + ДУ * НаправлениеY;
            Вправо = ДХ * ПравоX + ДУ * ПравоY;

            Если Вперед > 0.2 Тогда
                Запись = Новый Структура;
                Запись.Вставить("М", Монстр);
                Запись.Вставить("Вперед", Вперед);
                Запись.Вставить("Вправо", Вправо);
                Цели.Добавить(Запись);
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    // depth sort: farther first, nearer last (nearer overdraws)
    Инд = 1;

    Пока Инд < Цели.Количество() Цикл

        Тек = Цели[Инд];
        Дж = Инд - 1;

        Пока Дж >= 0 И Цели[Дж].Вперед < Тек.Вперед Цикл
            Цели[Дж + 1] = Цели[Дж];
            Дж = Дж - 1;
        КонецЦикла;

        Цели[Дж + 1] = Тек;
        Инд = Инд + 1;

    КонецЦикла;

    Для Каждого Цель Из Цели Цикл

        Монстр = Цель.М;
        Вперед = Цель.Вперед;
        Вправо = Цель.Вправо;

        ЭкранX = Цел(ШиринаЭкрана / 2 + (Вправо / Вперед) * (ШиринаЭкрана / 2) / Tan(FOV / 2));

        Размер = Цел(ВысотаЭкрана * 1.2 / Вперед);

        Если Размер < 3 Тогда
            Размер = 3;
        КонецЕсли;

        Если Размер > ВысотаЭкрана Тогда
            Размер = ВысотаЭкрана;
        КонецЕсли;

        ЦентрY = Цел(ВысотаЭкрана / 2);

        Если Монстр.DeathFrame > 0 Тогда

            Спрайт = СпрайтТрупа();

            ШиринаКорпуса = Цел(Размер * 0.6);
            ВысотаКорпуса = Цел(Размер * 0.25);

            Если ШиринаКорпуса < 3 Тогда
                ШиринаКорпуса = 3;
            КонецЕсли;

            Если ВысотаКорпуса < 2 Тогда
                ВысотаКорпуса = 2;
            КонецЕсли;

            Левая = ЭкранX - Цел(ШиринаКорпуса / 2);
            Правая = ЭкранX + Цел(ШиринаКорпуса / 2);
            Низ = ЦентрY + Цел(Размер / 2);
            Верх = Низ - ВысотаКорпуса;

        Иначе

            Спрайт = СпрайтДемона();

            Левая = ЭкранX - Цел(Размер / 3);
            Правая = ЭкранX + Цел(Размер / 3);
            Верх = ЦентрY - Цел(Размер / 2);
            Низ = ЦентрY + Цел(Размер / 2);

        КонецЕсли;

        Если Верх < 0 Тогда
            Верх = 0;
        КонецЕсли;

        Если Низ >= ВысотаЭкрана Тогда
            Низ = ВысотаЭкрана - 1;
        КонецЕсли;

        Если Левая < 0 Тогда
            Левая = 0;
        КонецЕсли;

        Если Правая >= ШиринаЭкрана Тогда
            Правая = ШиринаЭкрана - 1;
        КонецЕсли;

        ШиринаСпрайта = СтрДлина(Спрайт[0]);
        ВысотаСпрайта = Спрайт.Количество();

        ШиринаКлетки = Правая - Левая;
        ВысотаКлетки = Низ - Верх;

        Если ШиринаКлетки < 1 Тогда
            ШиринаКлетки = 1;
        КонецЕсли;

        Если ВысотаКлетки < 1 Тогда
            ВысотаКлетки = 1;
        КонецЕсли;

        Y = Верх;

        Пока Y <= Низ Цикл

            X = Левая;

            Пока X <= Правая Цикл

                Если Вперед < Глубина[X] Тогда

                    НормаX = (X - Левая) / ШиринаКлетки;
                    НормаY = (Y - Верх) / ВысотаКлетки;

                    СпрX = Цел(НормаX * (ШиринаСпрайта - 1)) + 1;
                    СпрY = Цел(НормаY * (ВысотаСпрайта - 1)) + 1;

                    Если СпрX < 1 Тогда
                        СпрX = 1;
                    КонецЕсли;

                    Если СпрX > ШиринаСпрайта Тогда
                        СпрX = ШиринаСпрайта;
                    КонецЕсли;

                    Если СпрY < 1 Тогда
                        СпрY = 1;
                    КонецЕсли;

                    Если СпрY > ВысотаСпрайта Тогда
                        СпрY = ВысотаСпрайта;
                    КонецЕсли;

                    Символ = Сред(Спрайт[СпрY - 1], СпрX, 1);

                    Если Символ <> " " Тогда
                        Поставить(Экран, X, Y, Символ);
                    КонецЕсли;

                КонецЕсли;

                X = X + 1;

            КонецЦикла;

            Y = Y + 1;

        КонецЦикла;

    КонецЦикла;

    НарисоватьПушку(Экран);

    Возврат Экран;

КонецФункции


Функция КоличествоЖивыхМонстров()

    Количество = 0;

    Для Каждого Монстр Из Монстры Цикл
        Если Монстр.Alive Тогда
            Количество = Количество + 1;
        КонецЕсли;
    КонецЦикла;

    Возврат Количество;

КонецФункции


Процедура ОтрисоватьКадр()

    // ponytail: ANSI home-cursor + ONE write. No Очистить, no per-line Сообщить -> no flicker.
    // Relies on output processing being on (docker-compose/run.sh use -icanon, not raw).
    Экран = Нарисовать();

    Если УронВспышка > 0 Тогда
        СимволРазд = "!";
    Иначе
        СимволРазд = "=";
    КонецЕсли;

    Разделитель = "";
    Счетчик = 0;

    Пока Счетчик < ШиринаЭкрана Цикл
        Разделитель = Разделитель + СимволРазд;
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Заполнено = Цел(ИгрокHP / 5);

    Если Заполнено < 0 Тогда
        Заполнено = 0;
    КонецЕсли;

    Если Заполнено > 20 Тогда
        Заполнено = 20;
    КонецЕсли;

    Полоса = "";
    Счетчик = 0;

    Пока Счетчик < 20 Цикл
        Если Счетчик < Заполнено Тогда
            Полоса = Полоса + "#";
        Иначе
            Полоса = Полоса + ".";
        КонецЕсли;
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Убито = Монстры.Количество() - КоличествоЖивыхМонстров();

    СтрокаHUD = " HP [" + Полоса + "] " + ИгрокHP + "/100" +
        "   KILLS " + Убито + "/" + Монстры.Количество() +
        "   WASD move   SPACE fire   Q quit";

    Пока СтрДлина(СтрокаHUD) < ШиринаЭкрана Цикл
        СтрокаHUD = СтрокаHUD + " ";
    КонецЦикла;

    Экран.Добавить(Разделитель);
    Экран.Добавить(СтрокаHUD);

    // single frame write: cursor home, then every line padded, ending with newline
    Кадр = Символ(27) + "[H";

    Для Каждого Стр Из Экран Цикл

        Пока СтрДлина(Стр) < ШиринаЭкрана Цикл
            Стр = Стр + " ";
        КонецЦикла;

        Кадр = Кадр + Стр + Символ(10);

    КонецЦикла;

    Консоль.ВывестиСтроку(Кадр);

КонецПроцедуры


Процедура ПоказатьСмерть()

    НомерКадра = 0;

    Пока НомерКадра < 4 Цикл

        Консоль.Очистить();

        Если НомерКадра % 2 = 0 Тогда
            Сообщить("");
            Сообщить("");
            Сообщить("========================================");
            Сообщить("              YOU DIED");
            Сообщить("========================================");
        КонецЕсли;

        Приостановить(300);
        НомерКадра = НомерКадра + 1;

    КонецЦикла;

    Консоль.Очистить();

    Сообщить("");
    Сообщить("");
    Сообщить("========================================");
    Сообщить("              YOU DIED");
    Сообщить("========================================");
    Сообщить("");
    Сообщить("            Press any key to exit");

    Таймер = 0;

    Пока Таймер < 60 Цикл

        Попытка
            Есть = Консоль.НажатаКлавиша;
        Исключение
            Есть = Ложь;
        КонецПопытки;

        Если Есть Тогда
            Прервать;
        КонецЕсли;

        Приостановить(50);
        Таймер = Таймер + 1;

    КонецЦикла;

КонецПроцедуры


Процедура Играть()

    Инициализация();

    Дельта = 0.05;

    Консоль.Очистить();

    ОтрисоватьКадр();

    Пока ИгрокHP > 0 Цикл

        ОбработатьКлавиши(Дельта);
        ПрименитьДвижение(Дельта);

        Если КадровВыстрела > 0 Тогда
            КадровВыстрела = КадровВыстрела - 1;
        КонецЕсли;

        ОбновитьМонстров(Дельта);

        ДХ = ИгрокX - ВыходX;
        ДУ = ИгрокY - ВыходY;
        РасстояниеДоВыхода = Sqrt(ДХ * ДХ + ДУ * ДУ);

        Если РасстояниеДоВыхода < 0.8 Тогда
            Консоль.Очистить();
            Сообщить("");
            Сообщить("========================================");
            Сообщить("              YOU WIN");
            Сообщить("========================================");
            Возврат;
        КонецЕсли;

        ОтрисоватьКадр();

        Приостановить(50);

    КонецЦикла;

    ПоказатьСмерть();

КонецПроцедуры


Играть();
