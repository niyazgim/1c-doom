Перем Карта;
Перем ИгрокX, ИгрокY, ИгрокУгол, ИгрокHP;
Перем ВыходX, ВыходY;
Перем ШиринаКарты, ВысотаКарты;
Перем ШиринаЭкрана, ВысотаЭкрана;
Перем FOV, МаксГлубина, ПИ;
Перем Монстры;

Процедура Инициализация()

    ПИ = 3.14159265359;

    Карта = Новый Массив;

    Карта.Добавить("################");
    Карта.Добавить("#S.............#");
    Карта.Добавить("#.###.###.####.#");
    Карта.Добавить("#.#.......#....#");
    Карта.Добавить("#.#.#####.#.##.#");
    Карта.Добавить("#...#...#......#");
    Карта.Добавить("#####.#.######.#");
    Карта.Добавить("#.......#......#");
    Карта.Добавить("#.#####.#.####.#");
    Карта.Добавить("#.....#.......E#");
    Карта.Добавить("################");

    ШиринаКарты = СтрДлина(Карта[0]);
    ВысотаКарты = Карта.Количество();

    ИгрокX = 1.5;
    ИгрокY = 1.5;
    ИгрокУгол = 0;
    ИгрокHP = 100;

    ВыходX = 14.5;
    ВыходY = 9.5;

    ШиринаЭкрана = 128;
    ВысотаЭкрана = 36;

    FOV = ПИ / 3;
    МаксГлубина = 16;

    Монстры = Новый Массив;

    ДобавитьМонстра(7.5, 1.5, 40);
    ДобавитьМонстра(12.5, 3.5, 50);
    ДобавитьМонстра(5.5, 7.5, 60);
    ДобавитьМонстра(12.5, 8.5, 70);

КонецПроцедуры


Процедура ДобавитьМонстра(Х, У, HP)

    Монстр = Новый Структура;

    Монстр.Вставить("X", Х);
    Монстр.Вставить("Y", У);
    Монстр.Вставить("HP", HP);
    Монстр.Вставить("Cooldown", 0);
    Монстр.Вставить("Alive", Истина);

    Монстры.Добавить(Монстр);

КонецПроцедуры


Функция МодульЧисла(Значение)

    Если Значение < 0 Тогда
        Возврат -Значение;
    КонецЕсли;

    Возврат Значение;

КонецФункции


Функция ЭтоСтена(Х, У)

    Если Х < 0 Или Х >= ШиринаКарты Тогда
        Возврат Истина;
    КонецЕсли;

    Если У < 0 Или У >= ВысотаКарты Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Сред(Карта[У], Х + 1, 1) = "#";

КонецФункции


Функция Свободно(Х, У)

    Если ЭтоСтена(Цел(Х), Цел(У)) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Истина;

КонецФункции


Функция РасстояниеДоСтены(Угол)

    Расстояние = 0;

    Пока Расстояние < МаксГлубина Цикл

        Расстояние = Расстояние + 0.08;

        ТестX = Цел(ИгрокX + Cos(Угол) * Расстояние);
        ТестY = Цел(ИгрокY + Sin(Угол) * Расстояние);

        Если ЭтоСтена(ТестX, ТестY) Тогда
            Возврат Расстояние;
        КонецЕсли;

    КонецЦикла;

    Возврат МаксГлубина;

КонецФункции


Функция ВидитИгрока(Х, У)

    ДХ = ИгрокX - Х;
    ДУ = ИгрокY - У;

    Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);

    Если Расстояние < 0.1 Тогда
        Возврат Истина;
    КонецЕсли;

    КоличествоШагов = Цел(Расстояние / 0.1);

    Если КоличествоШагов < 1 Тогда
        КоличествоШагов = 1;
    КонецЕсли;

    НомерШага = 1;

    Пока НомерШага <= КоличествоШагов Цикл

        Доля = НомерШага / КоличествоШагов;

        ПроверкаX = Х + ДХ * Доля;
        ПроверкаY = У + ДУ * Доля;

        Если ЭтоСтена(Цел(ПроверкаX), Цел(ПроверкаY)) Тогда
            Возврат Ложь;
        КонецЕсли;

        НомерШага = НомерШага + 1;

    КонецЦикла;

    Возврат Истина;

КонецФункции


Процедура ДвигатьИгрока(Вперед, Вправо, Дельта)

    Скорость = 2.5;
    Расстояние = Скорость * Дельта;

    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);

    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    НовX = ИгрокX +
        НаправлениеX * Вперед * Расстояние +
        ПравоX * Вправо * Расстояние;

    НовY = ИгрокY +
        НаправлениеY * Вперед * Расстояние +
        ПравоY * Вправо * Расстояние;

    Если Свободно(НовX, ИгрокY) Тогда
        ИгрокX = НовX;
    КонецЕсли;

    Если Свободно(ИгрокX, НовY) Тогда
        ИгрокY = НовY;
    КонецЕсли;

КонецПроцедуры


Процедура ОбновитьМонстров(Дельта)

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Тогда

            Если Монстр.Cooldown > 0 Тогда
                Монстр.Cooldown = Монстр.Cooldown - Дельта;
            КонецЕсли;

            ДХ = ИгрокX - Монстр.X;
            ДУ = ИгрокY - Монстр.Y;

            Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);

            Если Расстояние < 0.9 Тогда

                Если Монстр.Cooldown <= 0 Тогда
                    ИгрокHP = ИгрокHP - 10;
                    Монстр.Cooldown = 0.8;
                КонецЕсли;

            ИначеЕсли Расстояние < 12 И ВидитИгрока(Монстр.X, Монстр.Y) Тогда

                НаправлениеX = ДХ / Расстояние;
                НаправлениеY = ДУ / Расстояние;

                Скорость = 0.7;

                НовX = Монстр.X +
                    НаправлениеX * Скорость * Дельта;

                НовY = Монстр.Y +
                    НаправлениеY * Скорость * Дельта;

                Если Свободно(НовX, Монстр.Y) Тогда
                    Монстр.X = НовX;
                КонецЕсли;

                Если Свободно(Монстр.X, НовY) Тогда
                    Монстр.Y = НовY;
                КонецЕсли;

            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


Процедура Стрелять()

    ЛучшийМонстр = Неопределено;
    ЛучшееРасстояние = МаксГлубина;

    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);

    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Тогда

            ДХ = Монстр.X - ИгрокX;
            ДУ = Монстр.Y - ИгрокY;

            Вперед = ДХ * НаправлениеX +
                ДУ * НаправлениеY;

            Вправо = ДХ * ПравоX +
                ДУ * ПравоY;

            Если Вперед > 0.2 Тогда

                Расстояние = Sqrt(ДХ * ДХ + ДУ * ДУ);

                Если Расстояние < МаксГлубина Тогда

                    ШиринаПрицеливания = Вперед * 0.10 + 0.25;

                    Если МодульЧисла(Вправо) < ШиринаПрицеливания Тогда

                        Если ВидитИгрока(Монстр.X, Монстр.Y) Тогда

                            Если Расстояние < ЛучшееРасстояние Тогда
                                ЛучшееРасстояние = Расстояние;
                                ЛучшийМонстр = Монстр;
                            КонецЕсли;

                        КонецЕсли;

                    КонецЕсли;

                КонецЕсли;

            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    Если ЛучшийМонстр <> Неопределено Тогда

        ЛучшийМонстр.HP = ЛучшийМонстр.HP - 25;

        Если ЛучшийМонстр.HP <= 0 Тогда
            ЛучшийМонстр.Alive = Ложь;
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработатьКлавиши(Дельта)

    // ponytail: non-blocking poll (blocking read froze the first frame). Попытка guards runtimes
    // that lack НажатаКлавиша/ПрочитатьСимвол so a missing API degrades to "no input" instead of a crash.
    Попытка
        ЕстьКлавиша = Консоль.НажатаКлавиша;
    Исключение
        ЕстьКлавиша = Ложь;
    КонецПопытки;

    Счетчик = 0;

    Пока ЕстьКлавиша И Счетчик < 64 Цикл

        Попытка
            Клавиша = Консоль.ПрочитатьСимвол();
        Исключение
            Клавиша = Консоль.Прочитать();
        КонецПопытки;

        Счетчик = Счетчик + 1;

        Если Клавиша = "q" Или Клавиша = "Q" Тогда
            ИгрокHP = 0;
        ИначеЕсли Клавиша = "w" Или Клавиша = "W" Тогда
            ДвигатьИгрока(1, 0, Дельта);
        ИначеЕсли Клавиша = "s" Или Клавиша = "S" Тогда
            ДвигатьИгрока(-1, 0, Дельта);
        ИначеЕсли Клавиша = "a" Или Клавиша = "A" Тогда
            ИгрокУгол = ИгрокУгол - 2.5 * Дельта;
        ИначеЕсли Клавиша = "d" Или Клавиша = "D" Тогда
            ИгрокУгол = ИгрокУгол + 2.5 * Дельта;
        ИначеЕсли Клавиша = " " Тогда
            Стрелять();
        КонецЕсли;

        Попытка
            ЕстьКлавиша = Консоль.НажатаКлавиша;
        Исключение
            ЕстьКлавиша = Ложь;
        КонецПопытки;

    КонецЦикла;

КонецПроцедуры


Функция СимволСтены(Расстояние)

    Если Расстояние < 2 Тогда
        Возврат "#";
    ИначеЕсли Расстояние < 4 Тогда
        Возврат "=";
    ИначеЕсли Расстояние < 7 Тогда
        Возврат "-";
    ИначеЕсли Расстояние < 10 Тогда
        Возврат ":";
    Иначе
        Возврат ".";
    КонецЕсли;

КонецФункции


Функция СоздатьЭкран()

    Экран = Новый Массив;

    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаЭкрана Цикл

        Строка = "";

        НомерКолонки = 0;

        Пока НомерКолонки < ШиринаЭкрана Цикл
            Строка = Строка + " ";
            НомерКолонки = НомерКолонки + 1;
        КонецЦикла;

        Экран.Добавить(Строка);

        НомерСтроки = НомерСтроки + 1;

    КонецЦикла;

    Возврат Экран;

КонецФункции


Процедура Поставить(Экран, X, Y, Символ)

    Если X >= 0 И X < ШиринаЭкрана И Y >= 0 И Y < ВысотаЭкрана Тогда

        Строка = Экран[Y];

        Экран[Y] =
            Лев(Строка, X) +
            Символ +
            Сред(Строка, X + 2);

    КонецЕсли;

КонецПроцедуры


Функция СпрайтДемона()

    // ponytail: Doom-imp silhouette (horns + glowing eyes + claws)
    Спрайт = Новый Массив;

    Спрайт.Добавить("   /\   /\   ");
    Спрайт.Добавить("  /  \_/  \  ");
    Спрайт.Добавить(" |  o   o  | ");
    Спрайт.Добавить(" |    ^    | ");
    Спрайт.Добавить("  \  ---  /  ");
    Спрайт.Добавить("  /|     |\  ");
    Спрайт.Добавить(" / |     | \ ");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить("|  |     |  |");
    Спрайт.Добавить(" \ |     | / ");
    Спрайт.Добавить("  \|_____|/  ");
    Спрайт.Добавить("   |     |   ");
    Спрайт.Добавить("   |     |   ");
    Спрайт.Добавить("  / \   / \  ");
    Спрайт.Добавить(" /   \ /   \ ");

    Возврат Спрайт;

КонецФункции


Процедура НарисоватьПушку(Экран)

    // ponytail: wide double-barrel from the front, two visible bores. Distinct from prior models.
    Спрайт = Новый Массив;

    Спрайт.Добавить("      ______________________  ");
    Спрайт.Добавить("     /                      \ ");
    Спрайт.Добавить("    /________________________\");
    Спрайт.Добавить("    |  ______        ______  |");
    Спрайт.Добавить("    | |      |      |      | |");
    Спрайт.Добавить("    | |      |      |      | |");
    Спрайт.Добавить("    | |______|      |______| |");
    Спрайт.Добавить("    |________________________|");

    ВысотаПушки = Спрайт.Количество();
    ШиринаПушки = СтрДлина(Спрайт[0]);

    Левая = Цел((ШиринаЭкрана - ШиринаПушки) / 2);
    Верх = ВысотаЭкрана - ВысотаПушки;

    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаПушки Цикл

        НомерКолонки = 1;

        Пока НомерКолонки <= ШиринаПушки Цикл

            Символ = Сред(Спрайт[НомерСтроки], НомерКолонки, 1);

            Если Символ <> " " Тогда
                Поставить(
                    Экран,
                    Левая + НомерКолонки - 1,
                    Верх + НомерСтроки,
                    Символ
                );
            КонецЕсли;

            НомерКолонки = НомерКолонки + 1;

        КонецЦикла;

        НомерСтроки = НомерСтроки + 1;

    КонецЦикла;

КонецПроцедуры


Функция Нарисовать()

    Экран = СоздатьЭкран();

    Глубина = Новый Массив;
    ВерхМассив = Новый Массив;
    НизМассив = Новый Массив;
    СимволМассив = Новый Массив;

    // ponytail: precompute per-column wall span once, then emit row strings (O(W*H) char ops instead of O(W*H^2))
    Колонка = 0;

    Пока Колонка < ШиринаЭкрана Цикл

        Доля = Колонка / ШиринаЭкрана;

        Угол = ИгрокУгол - FOV / 2 + Доля * FOV;

        Расстояние = РасстояниеДоСтены(Угол);

        Исправленное =
            Расстояние * Cos(Угол - ИгрокУгол);

        Если Исправленное < 0.1 Тогда
            Исправленное = 0.1;
        КонецЕсли;

        Глубина.Добавить(Исправленное);

        ВысотаСтены =
            Цел(ВысотаЭкрана * 0.90 / Исправленное);

        Верх =
            Цел(ВысотаЭкрана / 2 - ВысотаСтены / 2);

        Низ =
            Цел(ВысотаЭкрана / 2 + ВысотаСтены / 2);

        Если Верх < 0 Тогда
            Верх = 0;
        КонецЕсли;

        Если Низ >= ВысотаЭкрана Тогда
            Низ = ВысотаЭкрана - 1;
        КонецЕсли;

        ВерхМассив.Добавить(Верх);
        НизМассив.Добавить(Низ);
        СимволМассив.Добавить(СимволСтены(Исправленное));

        Колонка = Колонка + 1;

    КонецЦикла;

    НомерСтроки = 0;

    Пока НомерСтроки < ВысотаЭкрана Цикл

        Строка = "";

        Колонка = 0;

        Пока Колонка < ШиринаЭкрана Цикл

            Если НомерСтроки < ВерхМассив[Колонка] Тогда

                Символ = " ";

            ИначеЕсли НомерСтроки <= НизМассив[Колонка] Тогда

                Символ = СимволМассив[Колонка];

            Иначе

                Символ = ".";

            КонецЕсли;

            Строка = Строка + Символ;

            Колонка = Колонка + 1;

        КонецЦикла;

        Экран[НомерСтроки] = Строка;

        НомерСтроки = НомерСтроки + 1;

    КонецЦикла;


    НаправлениеX = Cos(ИгрокУгол);
    НаправлениеY = Sin(ИгрокУгол);

    ПравоX = -Sin(ИгрокУгол);
    ПравоY = Cos(ИгрокУгол);

    Спрайт = СпрайтДемона();
    ВысотаСпрайта = Спрайт.Количество();
    ШиринаСпрайта = СтрДлина(Спрайт[0]);

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Тогда

            ДХ = Монстр.X - ИгрокX;
            ДУ = Монстр.Y - ИгрокY;

            Вперед =
                ДХ * НаправлениеX +
                ДУ * НаправлениеY;

            Вправо =
                ДХ * ПравоX +
                ДУ * ПравоY;

            Если Вперед > 0.2 Тогда

                Если МодульЧисла(Вправо) < Вперед * 1.2 Тогда

                    ЭкранX =
                        Цел(
                            ШиринаЭкрана / 2 +
                            (Вправо / Вперед) *
                            (ШиринаЭкрана / 2) /
                            Tan(FOV / 2)
                        );

                    Размер =
                        Цел(ВысотаЭкрана * 1.2 / Вперед);

                    Если Размер < 3 Тогда
                        Размер = 3;
                    КонецЕсли;

                    Если Размер > ВысотаЭкрана Тогда
                        Размер = ВысотаЭкрана;
                    КонецЕсли;

                    ЦентрY = Цел(ВысотаЭкрана / 2);

                    Верх = ЦентрY - Цел(Размер / 2);
                    Низ = ЦентрY + Цел(Размер / 2);

                    Левая = ЭкранX - Цел(Размер / 3);
                    Правая = ЭкранX + Цел(Размер / 3);

                    Если Верх < 0 Тогда
                        Верх = 0;
                    КонецЕсли;

                    Если Низ >= ВысотаЭкрана Тогда
                        Низ = ВысотаЭкрана - 1;
                    КонецЕсли;

                    Если Левая < 0 Тогда
                        Левая = 0;
                    КонецЕсли;

                    Если Правая >= ШиринаЭкрана Тогда
                        Правая = ШиринаЭкрана - 1;
                    КонецЕсли;

                    ШиринаКлетки = Правая - Левая;
                    ВысотаКлетки = Низ - Верх;

                    Если ШиринаКлетки < 1 Тогда
                        ШиринаКлетки = 1;
                    КонецЕсли;

                    Если ВысотаКлетки < 1 Тогда
                        ВысотаКлетки = 1;
                    КонецЕсли;

                    Y = Верх;

                    Пока Y <= Низ Цикл

                        X = Левая;

                        Пока X <= Правая Цикл

                            Если Вперед < Глубина[X] Тогда

                                НормаX =
                                    (X - Левая) / ШиринаКлетки;

                                НормаY =
                                    (Y - Верх) / ВысотаКлетки;

                                СпрX =
                                    Цел(НормаX * (ШиринаСпрайта - 1)) + 1;

                                СпрY =
                                    Цел(НормаY * (ВысотаСпрайта - 1)) + 1;

                                Если СпрX < 1 Тогда
                                    СпрX = 1;
                                КонецЕсли;

                                Если СпрX > ШиринаСпрайта Тогда
                                    СпрX = ШиринаСпрайта;
                                КонецЕсли;

                                Если СпрY < 1 Тогда
                                    СпрY = 1;
                                КонецЕсли;

                                Если СпрY > ВысотаСпрайта Тогда
                                    СпрY = ВысотаСпрайта;
                                КонецЕсли;

                                Символ =
                                    Сред(
                                        Спрайт[СпрY - 1],
                                        СпрX,
                                        1
                                    );

                                Если Символ <> " " Тогда
                                    Поставить(Экран, X, Y, Символ);
                                КонецЕсли;

                            КонецЕсли;

                            X = X + 1;

                        КонецЦикла;

                        Y = Y + 1;

                    КонецЦикла;

                КонецЕсли;

            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    НарисоватьПушку(Экран);

    Возврат Экран;

КонецФункции


Функция КоличествоЖивыхМонстров()

    Количество = 0;

    Для Каждого Монстр Из Монстры Цикл

        Если Монстр.Alive Тогда
            Количество = Количество + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат Количество;

КонецФункции


Процедура ПоказатьСмерть()

    // ponytail: 4-frame flicker, fixed 300ms cadence. Key-wait has a 5s timeout so a dead
    // НажатаКлавиша can't hang the process on exit.
    НомерКадра = 0;

    Пока НомерКадра < 4 Цикл

        Консоль.Очистить();

        Если НомерКадра % 2 = 0 Тогда

            Сообщить("");
            Сообщить("");
            Сообщить("========================================");
            Сообщить("              YOU DIED");
            Сообщить("========================================");

        КонецЕсли;

        Приостановить(300);

        НомерКадра = НомерКадра + 1;

    КонецЦикла;

    Консоль.Очистить();

    Сообщить("");
    Сообщить("");
    Сообщить("========================================");
    Сообщить("              YOU DIED");
    Сообщить("========================================");
    Сообщить("");
    Сообщить("            Press any key to exit");

    Таймер = 0;

    Попытка
        ЕстьКлавиша = Консоль.НажатаКлавиша;
    Исключение
        ЕстьКлавиша = Истина;
    КонецПопытки;

    Пока Не ЕстьКлавиша И Таймер < 100 Цикл

        Приостановить(50);
        Таймер = Таймер + 1;

        Попытка
            ЕстьКлавиша = Консоль.НажатаКлавиша;
        Исключение
            ЕстьКлавиша = Истина;
        КонецПопытки;

    КонецЦикла;

КонецПроцедуры


Процедура Играть()

    Инициализация();

    Консоль.Очистить();

    Дельта = 0.05;

    Пока ИгрокHP > 0 Цикл

        // render BEFORE input: input may be dead on this TTY, but the game must still show a frame
        Экран = Нарисовать();

        Консоль.КурсорВерх = 0;
        Консоль.КурсорЛево = 0;

        Консоль.ВывестиСтроку(
            "HP: " +
            ИгрокHP +
            "    WASD MOVE   SPACE FIRE   Q QUIT"
        );

        Для Каждого СтрокаЭкрана Из Экран Цикл
            Консоль.ВывестиСтроку(СтрокаЭкрана);
        КонецЦикла;

        ОбработатьКлавиши(Дельта);

        ОбновитьМонстров(Дельта);

        ДХ = ИгрокX - ВыходX;
        ДУ = ИгрокY - ВыходY;

        РасстояниеДоВыхода =
            Sqrt(ДХ * ДХ + ДУ * ДУ);

        Если РасстояниеДоВыхода < 0.8 Тогда

            Консоль.Очистить();

            Сообщить("");
            Сообщить("========================================");
            Сообщить("              YOU WIN");
            Сообщить("========================================");

            Возврат;

        КонецЕсли;

        Приостановить(50);

    КонецЦикла;

    ПоказатьСмерть();

КонецПроцедуры


Играть();
